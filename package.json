{
  "name": "vortex-appium-inspector",
  "version": "1.0.0",
  "description": "Appium-only Android inspector, recorder and Python pytest code generator",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test --test-concurrency=1 test/unit/*.test.ts test/integration/*.test.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "package:windows": "node scripts/package.mjs",
    "doctor": "node src/doctor.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "xpath": "0.0.34"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  }
}
